{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vault-crawl.local/v1/receipt.schema.json",
  "title": "Vault Crawl Receipt v1",
  "description": "Terminal or recovery evidence for an accepted durable run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_version", "lane", "host_id", "source_hashes", "run_id", "parent_run_id", "caller", "source_surface", "command", "execution_host", "inspected_scope", "accepted_ids", "refused_ids", "terminal_outcome", "counts", "budget_outcome", "duration_ms", "artifact_paths", "delivery_state", "software_commit", "software_version", "schema_versions", "adapter_version", "normalization_policy_version", "policy_hash", "configuration_hash", "seed_manifest_hash", "evidence_availability_state", "compact_receipt_path", "created_at_utc", "implementation_status"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "source_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 71 } },
    "run_id": { "type": "string", "minLength": 1 },
    "parent_run_id": { "type": "string", "minLength": 1 },
    "caller": { "type": "string", "minLength": 1 },
    "source_surface": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "enum": ["status", "doctor"] },
    "execution_host": { "type": "string", "minLength": 1 },
    "inspected_scope": { "type": "array", "items": { "type": "string" } },
    "accepted_ids": { "type": "array", "items": { "type": "string" } },
    "refused_ids": { "type": "array", "items": { "type": "string" } },
    "terminal_outcome": { "type": "string", "enum": ["success", "no-work", "partial", "refused", "failed", "recovery"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "bytes", "cache_hits", "duplicates", "parser_failures", "render_needed", "accepted", "refused"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "parser_failures": { "type": "integer", "minimum": 0 },
        "render_needed": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "refused": { "type": "integer", "minimum": 0 }
      }
    },
    "budget_outcome": { "type": "string", "const": "not-applicable-phase0" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "artifact_paths": { "type": "array", "items": { "type": "string" } },
    "delivery_state": { "type": "string", "const": "not-applicable-phase0" },
    "error_summary": { "type": "string" },
    "software_commit": { "type": "string", "minLength": 1 },
    "software_version": { "type": "string", "minLength": 1 },
    "schema_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "adapter_version": { "type": "string", "const": "not-applicable-phase0" },
    "normalization_policy_version": { "type": "string", "minLength": 1 },
    "policy_hash": { "type": "string", "minLength": 1 },
    "configuration_hash": { "type": "string", "minLength": 1 },
    "seed_manifest_hash": { "type": "string", "minLength": 1 },
    "evidence_availability_state": { "type": "string", "enum": ["hash-known", "available-local", "exported", "evicted-under-policy", "missing", "not-applicable"] },
    "compact_receipt_path": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "implementation_status": { "type": "string", "const": "phase0-contract-only" }
  }
}
