{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vault-crawl.local/v1/policy.schema.json",
  "title": "Vault Crawl Policy v1",
  "description": "Versioned policy contract. Phase 0 is schema-only and inactive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_version",
    "lane",
    "host_id",
    "source_hashes",
    "policy_id",
    "implementation_status",
    "allowed_schemes",
    "default_methods",
    "automatic_ports",
    "proxy_support",
    "tls_verification",
    "robots_default",
    "activation_state"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "producer_version": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "source_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 71 } },
    "policy_id": { "type": "string", "minLength": 1 },
    "implementation_status": { "type": "string", "const": "schema-only" },
    "allowed_schemes": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "enum": ["http", "https"] }
    },
    "default_methods": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "enum": ["GET", "HEAD"] }
    },
    "automatic_ports": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "proxy_support": { "type": "boolean", "const": false },
    "tls_verification": { "type": "boolean", "const": true },
    "robots_default": { "type": "string", "const": "fail-closed" },
    "activation_state": { "type": "string", "const": "disabled" }
  }
}
