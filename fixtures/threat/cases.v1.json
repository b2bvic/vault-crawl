    {
      "kind": "authority",
      "name": "caller-identity-is-not-request-controlled",
      "bound_caller": "project-a-cli",
      "bound_surface": "cli",
      "allowed_projects": ["project-a"],
      "allowed_capabilities": ["status", "doctor"],
      "requested_caller": "project-b-cli",
      "requested_surface": "cli",
